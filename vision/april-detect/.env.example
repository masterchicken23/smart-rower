# Copy to .env to override. Every value here is the built-in default, so an
# empty .env and no .env behave identically.

# -- cameras -----------------------------------------------------------------
# Each camera's imageZMQ PUB address. The sender binds, the detector connects.
CAM1_SOURCE=tcp://cam1.local:5555
CAM2_SOURCE=tcp://cam2.local:5555
CAM3_SOURCE=tcp://cam3.local:5555
CAM4_SOURCE=tcp://cam4.local:5555

# Calibration per camera, as a path inside the container (./config is mounted
# at /config). Empty: no correction, focal length guessed from a 70 deg HFOV,
# and a warning in the log -- positions will be approximate.
# See config/example-camera.yaml for the format.
CAM1_CALIB=
CAM2_CALIB=
CAM3_CALIB=
CAM4_CALIB=

# -- tags --------------------------------------------------------------------
APRIL_FAMILIES=tag36h11
# Edge of the black square, metres. Per-id overrides: "3:0.05,7:0.20".
APRIL_TAG_SIZE_M=0.10
APRIL_TAG_SIZES=
# Report only these ids (comma-separated); empty reports every decoded tag.
APRIL_TAG_IDS=

# -- detector ----------------------------------------------------------------
# cpu meets 4 x 15 fps at 720p (README, "Throughput").
APRIL_DETECTOR=cpu
# Threads per container: 4 x 2 on the Orin Nano's 6 cores.
APRIL_THREADS=2
# 2: ~3x faster than 1; the smallest findable tag doubles in pixels.
APRIL_DECIMATE=2.0
# Blur before quad detection; keeps detection time flat on noisy frames.
APRIL_SIGMA=0.8
# image | points | none -- see april_detect/calib.py.
APRIL_UNDISTORT=image

# -- output ------------------------------------------------------------------
# true: each detector binds its own port (5561..5564) and the funnel connects.
APRIL_OUT_BIND=true

APRIL_LOG_LEVEL=info
APRIL_STATS_INTERVAL_S=5
