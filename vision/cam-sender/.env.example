# Copy to .env to override. Every value here is the built-in default, so an
# empty .env and no .env behave identically. The same CAM_* variables work
# without Docker; a command-line flag wins over them.

# Camera id in every frame header. Empty: the Pi's hostname. Match the
# detector's APRIL_CAMERA_ID (cam1..cam4) or leave that empty to adopt this.
CAM_NAME=
# The detector connects here (its APRIL_SOURCE / CAMn_SOURCE).
CAM_BIND=tcp://*:5555

# hw: GPU MJPEG (the only way a Zero W holds 720p15). sw: CPU simplejpeg.
# uvc: USB webcam, its MJPEG passed through. test: synthetic frames, no camera.
CAM_BACKEND=hw
# uvc only: the webcam's V4L2 device.
CAM_DEVICE=/dev/video0
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=15
CAM_HFLIP=false
CAM_VFLIP=false

# Greyscale unless true. The detector uses luminance only.
CAM_COLOR=false
# KB per frame. 35 at 15 fps is ~4.3 Mbit/s; four cameras ~17 Mbit/s, which
# one 2.4 GHz channel carries (april-detect SENDER.md, "Size").
CAM_TARGET_KB=35
# sw backend: starting JPEG quality, servoed toward CAM_TARGET_KB.
CAM_QUALITY=60

# -- local recording (README, "Local recording") -----------------------------
# Also write every frame to this Pi's disk, started and stopped with the
# recorder's sessions on the Jetson (embedded/recorder) and named as they are.
CAM_RECORD=false
# Native only; in Docker the directory is CAM_REC_DATA below.
CAM_RECORD_DIR=rec
# The recorder's camera control address (its REC_CAM_CONTROL_BIND). Use the
# Jetson's IP, not a .local name. Required with CAM_RECORD=true.
CAM_REC_CONTROL=
# Frames waiting for the disk (~1 min); past it the oldest is dropped from the
# recording, never from the stream.
CAM_REC_QUEUE_MB=32
# Sessions refuse to start, and running ones stop, below this much free space.
CAM_REC_MIN_FREE_MB=1000
# Stop a session after this long, in case the recorder's stop never arrives.
CAM_REC_MAX_S=10800
# Seconds between fsyncs: the most a power cut can cost.
CAM_REC_FSYNC_S=5

CAM_STATS_INTERVAL_S=5

# Docker only: the image docker/build-base.sh produced.
CAM_BASE_IMAGE=smart-rower/raspbian-bookworm-armv6:base
# Docker only: host directory for local recordings, mounted at /rec.
CAM_REC_DATA=./rec
