# Native (no Docker) autostart.
#
#   sudo cp cam-sender.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cam-sender
#   journalctl -u cam-sender -f
#
# Edit User= and WorkingDirectory= to where this folder lives. Settings: the
# CAM_* variables (see .env.example), here or in EnvironmentFile.

[Unit]
Description=smart-rower camera sender (JPEG over ZMQ for april-detect)
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/smart-rower/vision/cam-sender
EnvironmentFile=-/home/pi/smart-rower/vision/cam-sender/.env
ExecStart=/usr/bin/python3 -m cam_sender
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
