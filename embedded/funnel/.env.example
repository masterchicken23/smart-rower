# Copy to .env to override. Every value here is the built-in default, so an
# empty .env and no .env behave identically.

# -- ingest ------------------------------------------------------------------
# Inside compose the broker is reached by service name. Only change this if you
# point the funnel at a broker you run yourself.
FUNNEL_MQTT_HOST=mosquitto
FUNNEL_MQTT_PORT=1883
FUNNEL_MQTT_TOPICS=rower/+/+,boat/+

# -- compute -----------------------------------------------------------------
# 10 Hz: comfortably faster than a phone's refresh and than stroke dynamics
# (~0.5 Hz), with plenty of headroom on an Orin Nano.
FUNNEL_COMPUTE_HZ=10
FUNNEL_BUFFER_SECONDS=10
FUNNEL_BUFFER_MAX_SAMPLES=2048

# -- seat position pipeline --------------------------------------------------
# Tuning for /rower/<seat>/position; see funnel/config.py for each one. The
# defaults favour a steady output over a fast one.
FUNNEL_SEAT_MIN_MM=20
FUNNEL_SEAT_MAX_MM=1000
# true: the seat moves towards the sensor on the drive (catch = far extreme).
FUNNEL_SEAT_DISTANCE_DECREASES_TO_FINISH=true
FUNNEL_SEAT_MAX_SPEED_MMS=3000
FUNNEL_SEAT_GATE_SLACK_MM=40
FUNNEL_SEAT_DESPIKE_WINDOW_S=0.25
FUNNEL_SEAT_SMOOTH_CUTOFF_HZ=2.0
FUNNEL_SEAT_VELOCITY_WINDOW_S=0.2
FUNNEL_SEAT_TURN_HYSTERESIS_MM=60
FUNNEL_SEAT_MIN_SPAN_MM=150
FUNNEL_SEAT_MAX_HALF_STROKE_S=5.0
FUNNEL_SEAT_ENDPOINT_STROKES=8
FUNNEL_SEAT_RESET_GAP_S=1.0

# -- serving -----------------------------------------------------------------
FUNNEL_HTTP_PORT=8000
FUNNEL_CORS=*
# Past this age a per-resource endpoint answers 503 instead of serving a stale
# reading as current. 0 disables the check.
FUNNEL_MAX_AGE_MS=1000
FUNNEL_ACCESS_LOG=false
FUNNEL_LOG_LEVEL=info

# -- debug -------------------------------------------------------------------
# Recording is for debug runs and is off in normal operation.
FUNNEL_RECORD_ENABLED=false
FUNNEL_RECORD_DIR=/data
# Set to a session directory under FUNNEL_RECORD_DIR to replay it instead of
# ingesting from MQTT -- lets you work on the metrics with no boat.
FUNNEL_REPLAY_PATH=
FUNNEL_REPLAY_SPEED=1.0

# AprilTag detections from vision/april-detect, one detector per camera. The
# detectors use host networking and bind 5561..5564; inside compose they are
# reached through host.docker.internal (see docker-compose.yml).
FUNNEL_APRILTAG_ENABLED=false
FUNNEL_APRILTAG_CONNECT=tcp://127.0.0.1:5561,tcp://127.0.0.1:5562,tcp://127.0.0.1:5563,tcp://127.0.0.1:5564
# Which rower each camera watches: <camera id>:<seat>, seat 1-based, bow = 1.
# A camera not listed here is ignored (and listed under /health), never
# guessed. Data appears at /rower/<seat>/apriltag.
FUNNEL_APRILTAG_CAMERAS=

# Not implemented yet; see funnel/sources/zmq_pose.py.
FUNNEL_ZMQ_ENABLED=false
