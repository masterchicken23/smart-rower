# Copy to .env to override. Every value here is the built-in default, so an
# empty .env and no .env behave identically.

# -- storage -----------------------------------------------------------------
# Host directory for sessions. Use the NVMe, not the SD card.
REC_DATA=./data
# Sessions refuse to start, and running ones stop, below this much free space.
REC_MIN_FREE_GB=2

# -- control -----------------------------------------------------------------
# Not 8000 (the funnel's). Every route is under /recorder.
REC_HTTP_PORT=8010
REC_CORS=*
# Start a session as soon as the container is up.
REC_AUTOSTART=false

# -- sources -----------------------------------------------------------------
# The funnel's broker, published on the host.
REC_MQTT_HOST=127.0.0.1
REC_MQTT_PORT=1883
REC_MQTT_TOPICS=#
# <name>=<endpoint> per camera: the april-detect raw frame tees (CAMn_TEE in
# vision/april-detect/.env). A camera's own address also works
# (cam1=tcp://cam1.local:5555) at the cost of a second Wi-Fi copy of its
# stream. Empty: no video.
REC_CAMERAS=cam1=tcp://127.0.0.1:5571,cam2=tcp://127.0.0.1:5572,cam3=tcp://127.0.0.1:5573,cam4=tcp://127.0.0.1:5574
# Detector outputs (as FUNNEL_APRILTAG_CONNECT). Empty: no detections.
REC_APRILTAG_CONNECT=tcp://127.0.0.1:5561,tcp://127.0.0.1:5562,tcp://127.0.0.1:5563,tcp://127.0.0.1:5564

# -- the cameras' own recordings (README, "Recording on the cameras too") ----
# Start and stop each camera's local recording (vision/cam-sender with
# CAM_RECORD=true) with every session. false: cameras are told to stay idle.
REC_CAM_SYNC=true
# Where the cameras connect (their CAM_REC_CONTROL). Empty: no socket at all.
REC_CAM_CONTROL_BIND=tcp://*:5580

# -- writing -----------------------------------------------------------------
# Data waiting for the disk; past it the oldest waiting item is dropped (counted).
REC_QUEUE_MB=256
# Seconds between fsyncs: the most a pulled battery can cost. 0 disables.
REC_FSYNC_S=5
REC_LOG_LEVEL=info
